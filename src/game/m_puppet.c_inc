/* m_puppet.c_inc - networked puppet residents (multiplayer fork).
 *
 * Included at the END of m_player.c so it can reuse the file's static player
 * helpers and the player model. A puppet is a PLAYER_ACTOR instance driven
 * entirely by network state: it stands where the other resident stands,
 * plays the animation their game is playing, and is dressed from their own
 * save block (model, face, skin, shirt), not from the local player's.
 *
 * WHICH ACTOR PART IT LIVES IN MATTERS. Actor parts are types: gameplay code
 * walks a part's list and blindly casts every entry to that part's struct.
 * The player part would make GET_PLAYER_ACTOR_NOW() find a puppet; the NPC
 * part crashed the game because aNPC_greeting_area_check (run by every
 * villager every frame) cast the puppet to NPC_ACTOR* and dereferenced a
 * pointer field that, in a PLAYER_ACTOR, is the float 1.0f. The puppet
 * therefore lives in ACTOR_PART_UNUSED: no profile in the game uses it, and
 * an audit of every reader of that list (the generic loops in m_actor.c and
 * m_camera2.c, and aINS_get_stress in ac_insect_move.c_inc) found they only
 * touch the common ACTOR header. Do not move it without repeating that audit.
 *
 * Everything here is compiled only for the PC build and is inert unless a
 * server is connected. See docs/MULTIPLAYER.md and docs/HANDOFF.md.
 */
#ifdef TARGET_PC

#include "ac_puppet.h"
#include "pc_net.h"
#include "pc_save_bswap.h"
#include "pc_bswap.h"
#include "m_field_info.h"
#include "m_needlework.h"
#include "m_private.h"
#include "m_scene_table.h"
#include "ac_weather.h"
#include "ac_npc.h"
#include "m_demo.h"
#include "m_lib.h" /* Game_play_Projection_Trans */
#include <stddef.h>

#define PUPPET_PROFILE_ID mAc_PROFILE_PUPPET
#define PUPPET_ACTOR_PART ACTOR_PART_UNUSED /* see the header comment before changing */

/* The wire protocol's idea of "standing still" must be the player's own. */
typedef char puppet_wire_anim_check[(ACNET_PLAYER_ANIM_WAIT == mPlayer_ANIM_WAIT1) ? 1 : -1];
typedef char puppet_wire_area_check[(ACNET_AREA_FIELD == SCENE_FG) ? 1 : -1];
typedef char puppet_wire_mode_check[(ACNET_ANIM_MODE_STOP == cKF_FRAMECONTROL_STOP &&
                                     ACNET_ANIM_MODE_REPEAT == cKF_FRAMECONTROL_REPEAT) ? 1 : -1];
/* Runtime field placeholders start where the protocol says they do. */
typedef char puppet_runtime_start_check[(ACNET_LAND_RUNTIME_START == DUMMY_START) ? 1 : -1];
typedef char puppet_runtime_end_check[(ACNET_LAND_RUNTIME_END == RSV_SHOP_PAPER) ? 1 : -1];
typedef char puppet_grow_time_check[(sizeof(lbRTC_time_c) <= ACNET_GROW_TIME_SIZE) ? 1 : -1];
/* The server tells an empty save block by its PersonalID; keep the offset honest. */
typedef char puppet_id_offset_check[(offsetof(Private_c, player_ID.player_id) == ACNET_PRIVATE_ID_OFFSET) ? 1 : -1];

/* True once the resident is actually in the town. The title demo and the
 * player-select screens run a player actor too (the title even sets
 * player_no to 0 for its demo character), and none of that should reach
 * the other residents. */
static int Puppet_in_town(GAME_PLAY* play) {
    switch (play->scene_id) {
        case SCENE_TITLE_DEMO:
        case SCENE_PLAYERSELECT:
        case SCENE_PLAYERSELECT_2:
        case SCENE_PLAYERSELECT_3:
        case SCENE_PLAYERSELECT_SAVE:
            return FALSE;
        default:
            return TRUE;
    }
}

/* Where a resident is, for deciding whether we can see them: the scene,
 * and for the scenes that several places share -- a resident's house rooms
 * (one scene per size), a villager's house -- WHICH house, from the owner
 * the game recorded on the way in (a house index for a resident's house,
 * the villager's name for theirs). A resident indoors must not be drawn at
 * their room coordinates in our field, and two residents in two different
 * houses of the same size must not see each other either. */
static u32 Puppet_area(GAME_PLAY* play) {
    int scene = play->scene_id;
    u32 house = 0;

    if (mSc_IS_SCENE_PLAYER_ROOM(scene) || scene == SCENE_NPC_HOUSE || scene == SCENE_COTTAGE_NPC) {
        mActor_name_t owner = Common_Get(house_owner_name);
        if (owner != RSV_NO) {
            house = ((u32)owner + 1) & 0xFFFF;
        }
    }
    return ACNET_AREA_MAKE(scene, house);
}

/* The puppet's body for collisions: the same 20 x 60 pipe as the player, in
 * collision group 2 so nothing mistakes it for the player (group 1) or a
 * villager (group 3), and immovable, since its position comes from the
 * network: the local player and the villagers are the ones pushed aside. */
// clang-format off
static ClObjPipeData_c Puppet_OcInfoData = {
    { 0x39, ClObj_FLAG2_IS_GROUP_2, ClObj_TYPE_PIPE }, /* ClObjData_c */
    { 0x01 }, /* ClObjElemData_c */
    { { 20, 60, 0, { 0, 0, 0 } } }, /* ClObjPipeAttrData_c */
};
// clang-format on

/* --- Look -------------------------------------------------------------
 * One resident's face, skin and shirt as the player draw code wants them:
 * the eye/mouth texture strip, the face palette, the shirt texture and its
 * palette. The real player keeps exactly one copy of each in an object bank
 * (m_player_lib.c), read from Now_Private; a puppet gets its own copy here,
 * read from THAT resident's Private_c block, which every client has in the
 * shared save and which live resident sync keeps fresh. */
#define PUPPET_TEX_STRIDE 0x100
#define PUPPET_FACE_TEX_SIZE ((mPlayer_EYE_TEX_NUM + mPlayer_MOUTH_TEX_NUM) * PUPPET_TEX_STRIDE) /* 0xE00 */
typedef char puppet_face_size_check[(PUPPET_FACE_TEX_SIZE == 0xE00) ? 1 : -1];

typedef struct {
    int valid;
    /* What the buffers were built from; rebuilt when any of it changes. */
    int gender;
    int face;
    int cloth_idx;
    int sunburn;
    int swell;
    u8  face_tex[PUPPET_FACE_TEX_SIZE] ATTRIBUTE_ALIGN(32);
    u8  cloth_tex[mNW_DESIGN_TEX_SIZE] ATTRIBUTE_ALIGN(32);
    u16 face_pal[mNW_PALETTE_SIZE / sizeof(u16)] ATTRIBUTE_ALIGN(32);
    u16 cloth_pal[mNW_PALETTE_SIZE / sizeof(u16)] ATTRIBUTE_ALIGN(32);
} puppet_look_t;

static puppet_look_t s_look[ACNET_MAX_PLAYERS];

/* What each puppet is currently playing, so a change can be detected. */
typedef struct {
    int anim0;
    int anim1;
    int part_table;
    int built_gender; /* the body the actor was built with */
    u16 seq;          /* last state sample applied */
    int have_seq;
    int item_kind;    /* what is in its hand (mPlayer_ITEM_KIND_*), -1 for nothing */
    int item_anim;    /* the tool's own animation (item data index), -1 for none */
    int mode0, mode1; /* one-shot or looping, per layer */
    int item_mode;
    int   show_item;  /* an item shown overhead / in the hands (a pick-up), and where */
    f32   show_scale; /* 0 = nothing shown */
    xyz_t show_pos;
} puppet_anim_t;

static puppet_anim_t s_anim[ACNET_MAX_PLAYERS];

static Private_c* Puppet_private(int slot) {
    return Save_GetPointer(private_data[slot]);
}

static int Puppet_slot_has_resident(int slot) {
    return mPr_NullCheckPersonalID(&Puppet_private(slot)->player_ID) == FALSE;
}

static int Puppet_gender(int slot) {
    return Puppet_private(slot)->gender == mPr_SEX_FEMALE ? mPr_SEX_FEMALE : mPr_SEX_MALE;
}

/* (Re)build a resident's look from their save block if anything changed. */
static void Puppet_look_refresh(int slot, int swell) {
    puppet_look_t* look = &s_look[slot];
    Private_c* priv = Puppet_private(slot);
    int in_aram;
    u32 src;

    if (!Puppet_slot_has_resident(slot)) {
        look->valid = 0;
        return;
    }
    if (look->valid && look->gender == priv->gender && look->face == priv->face &&
        look->cloth_idx == priv->cloth.idx && look->sunburn == priv->sunburn.rank && look->swell == swell) {
        return;
    }

    look->gender = priv->gender;
    look->face = priv->face;
    look->cloth_idx = priv->cloth.idx;
    look->sunburn = priv->sunburn.rank;
    look->swell = swell;

    /* Eyes and mouths (14 textures of 0x100), then the face palette. The
     * palettes are stored big-endian on the disc, as in mPlib_change_player_face. */
    _JW_GetResourceAram(mPlib_Get_FaceTexRom_p_for(priv, swell), look->face_tex, PUPPET_FACE_TEX_SIZE);
    _JW_GetResourceAram(mPlib_Get_FacePalletRom_p_for(priv, swell), (u8*)look->face_pal, mNW_PALETTE_SIZE);
    pc_bswap16_array(look->face_pal, mNW_PALETTE_SIZE / sizeof(u16));

    /* Shirt: a built-in design from the disc, or one of their own designs
     * straight out of their save block (already in memory order). */
    src = mPlib_Get_PlayerTexRom_p_for(priv, &in_aram);
    if (in_aram) {
        _JW_GetResourceAram(src, look->cloth_tex, mNW_DESIGN_TEX_SIZE);
    } else {
        memcpy(look->cloth_tex, (const void*)src, mNW_DESIGN_TEX_SIZE);
    }
    src = mPlib_Get_PlayerPalletRom_p_for(priv, &in_aram);
    if (in_aram) {
        _JW_GetResourceAram(src, (u8*)look->cloth_pal, mNW_PALETTE_SIZE);
        pc_bswap16_array(look->cloth_pal, mNW_PALETTE_SIZE / sizeof(u16));
    } else {
        memcpy(look->cloth_pal, (const void*)src, mNW_PALETTE_SIZE);
    }

    look->valid = 1;
    OSReport("[puppet] resident %d looks like: %s, face %d, shirt %d%s%s\n", slot,
             priv->gender == mPr_SEX_FEMALE ? "girl" : "boy", (int)priv->face, (int)priv->cloth.idx,
             priv->sunburn.rank > 0 ? ", sunburnt" : "", swell ? ", bee-stung" : "");
}

/* --- Animation ---------------------------------------------------------- */

static f32 Puppet_clamp_frame(const cKF_Animation_R_c* anim, f32 frame) {
    f32 max = (f32)anim->frames;

    if (!(frame >= 1.0f)) { /* also catches NaN off the wire */
        return 1.0f;
    }
    if (frame > max) {
        return max;
    }
    return frame;
}

/* A fresh sample of the animation we are already playing: we have been
 * advancing it ourselves at the sender's speed, so only snap to their frame
 * if we have drifted, which keeps 30 Hz samples from making a 60 fps puppet
 * stutter. A looping animation may legitimately be a whole loop apart. */
static void Puppet_resync_frame(cKF_FrameControl_c* fc, f32 frame) {
    f32 max = fc->max_frames;
    f32 diff;

    if (max < 1.0f) {
        return;
    }
    if (!(frame >= 1.0f)) {
        frame = 1.0f;
    } else if (frame > max) {
        frame = max;
    }
    diff = fc->current_frame - frame;
    if (diff < 0.0f) {
        diff = -diff;
    }
    if (fc->mode == cKF_FRAMECONTROL_REPEAT && diff > max * 0.5f) { /* wrapped around the loop */
        diff = max - diff;
    }
    if (diff > 2.0f) {
        fc->current_frame = frame;
    }
}

static int Puppet_mode(int wire_mode) {
    return wire_mode == ACNET_ANIM_MODE_STOP ? cKF_FRAMECONTROL_STOP : cKF_FRAMECONTROL_REPEAT;
}

/* Eyes and mouth: an animation that scripts them (yawns, laughs) drives them
 * by frame exactly as for the player; otherwise the ordinary blink. */
static void Puppet_face_animation(ACTOR* actorx) {
    PLAYER_ACTOR* p = (PLAYER_ACTOR*)actorx;
    cKF_FrameControl_c* fc = &p->keyframe0.frame_control;
    u8* eye_tbl = mPlib_Get_PlayerEyeTexAnimation_p(p->animation0_idx);
    u8* mouth_tbl = mPlib_Get_PlayerMouthTexAnimation_p(p->animation0_idx);
    int pattern = -1;

    if (fc->current_frame >= 1.0f && fc->current_frame <= fc->max_frames) {
        pattern = (int)(fc->current_frame - 1.0f);
    }
    if (eye_tbl != NULL && pattern >= 0) {
        Player_actor_set_eye_pattern(actorx, eye_tbl[pattern]);
    } else {
        Player_actor_set_eye_pattern_normal(actorx);
    }
    if (mouth_tbl != NULL && pattern >= 0) {
        Player_actor_set_mouth_pattern(actorx, mouth_tbl[pattern]);
    } else {
        Player_actor_set_mouth_pattern(actorx, 0);
    }
}

/* Start `anim0`/`anim1` with `part` on the puppet, at the given frames, each
 * layer one-shot or looping as the sender's is. */
static void Puppet_start_animation(PLAYER_ACTOR* p, int slot, int anim0, int anim1, int part, f32 frame0, f32 frame1,
                                   f32 speed, f32 morph, int mode0, int mode1) {
    puppet_anim_t* a = &s_anim[slot];
    cKF_Animation_R_c* a0 = mPlib_Get_Pointer_Animation(anim0);
    cKF_Animation_R_c* a1 = mPlib_Get_Pointer_Animation(anim1);

    if (a0 == NULL) {
        anim0 = mPlayer_ANIM_WAIT1;
        a0 = mPlib_Get_Pointer_Animation(anim0);
    }
    if (a1 == NULL) {
        anim1 = anim0;
        a1 = a0;
    }
    if (part < 0 || part >= mPlayer_PART_TABLE_NUM) {
        part = mPlayer_PART_TABLE_NORMAL;
    }

    cKF_SkeletonInfo_R_init_standard_setframeandspeedandmorphandmode(&p->keyframe0, a0, NULL,
                                                                     Puppet_clamp_frame(a0, frame0), speed, morph,
                                                                     Puppet_mode(mode0));
    cKF_SkeletonInfo_R_init_standard_setframeandspeedandmorphandmode(&p->keyframe1, a1, NULL,
                                                                     Puppet_clamp_frame(a1, frame1), speed, morph,
                                                                     Puppet_mode(mode1));
    mPlib_DMA_player_Part_Table(p->part_table, part);
    p->animation0_idx = anim0;
    p->animation1_idx = anim1;
    p->part_table_idx = part;
    a->anim0 = anim0;
    a->anim1 = anim1;
    a->part_table = part;
    a->mode0 = mode0;
    a->mode1 = mode1;
}

/* --- Held items -----------------------------------------------------------
 * The tool models are plain display lists and skeletons in the executable
 * (mPlib_Get_Item_DataPointer), shared by everyone, so a puppet can hold any
 * tool without disturbing the local player's. A static tool (axe, shovel)
 * is drawn at the puppet's right hand; a bending one (net, rod) is a small
 * skeleton with its own animation, which the sender streams as well; an
 * umbrella is the game's own umbrella tool actor, born as the puppet's child
 * exactly as it is for the player. */
static void Puppet_set_item_anim(PLAYER_ACTOR* p, int slot, int anim, f32 frame, int mode) {
    puppet_anim_t* a = &s_anim[slot];
    cKF_SkeletonInfo_R_c* kf = &p->item_keyframe;

    a->item_anim = anim;
    a->item_mode = mode;
    if (kf->skeleton == NULL) {
        return;
    }
    if (!mPlayer_ITEM_DATA_VALID(anim) || mPlib_Get_Item_DataPointerType(anim) == mPlayer_ITEM_DATA_TYPE_GFX ||
        mPlib_Get_Item_DataPointerType(anim) == mPlayer_ITEM_DATA_TYPE_SKELETON) {
        /* No animation for it: use the tool's basic pose. */
        anim = mPlib_Get_BasicItemAnimeIndex_fromItemKind(a->item_kind);
        if (!mPlayer_ITEM_DATA_VALID(anim)) {
            kf->animation = NULL;
            return;
        }
    }
    if (!(frame >= 1.0f)) {
        frame = 1.0f;
    }
    /* One-shot or looping as the sender's tool animation is (a swing holds
     * its last frame; the ready pose loops). */
    cKF_SkeletonInfo_R_init_standard_setframeandspeedandmorphandmode(kf, mPlib_Get_Item_DataPointer(anim), NULL,
                                                                     frame, 1.0f, 0.0f, Puppet_mode(mode));
}

static void Puppet_drop_umbrella(PLAYER_ACTOR* p) {
    if (p->umbrella_actor != NULL) {
        Actor_delete(p->umbrella_actor); /* it must never outlive its parent: its draw reads the parent */
        p->umbrella_actor = NULL;
    }
}

static void Puppet_set_item(PLAYER_ACTOR* p, int slot, int kind, int anim, f32 frame, int mode) {
    puppet_anim_t* a = &s_anim[slot];
    int shape = -1;

    if (!mPlayer_ITEM_KIND_VALID(kind)) {
        kind = -1;
    }
    a->item_kind = kind;
    p->item_kind = (s8)kind;
    p->item_scale = 1.0f;
    p->item_bank_idx = 0;
    p->item_keyframe.skeleton = NULL;
    p->item_keyframe.animation = NULL;
    if (!mPlayer_ITEM_IS_UMBRELLA(kind)) {
        Puppet_drop_umbrella(p);
        p->umbrella_state = aTOL_ACTION_WAIT;
    } else {
        p->umbrella_state = aTOL_ACTION_TAKEOUT; /* Player_actor_Get_umbrella_p births it on the first draw */
    }
    if (kind >= 0) {
        shape = mPlib_Get_BasicItemShapeIndex_fromItemKind(kind);
    }
    p->item_shape_type[0] = shape;
    p->item_shape_type[1] = -1;
    if (mPlayer_ITEM_DATA_VALID(shape) && mPlib_Get_Item_DataPointerType(shape) != mPlayer_ITEM_DATA_TYPE_GFX) {
        cKF_SkeletonInfo_R_ct(&p->item_keyframe, mPlib_Get_Item_DataPointer(shape), NULL, p->item_joint_data,
                              p->item_morph_data);
        Puppet_set_item_anim(p, slot, anim, frame, mode);
    } else {
        a->item_anim = anim;
        a->item_mode = mode;
    }
    OSReport("[puppet] resident %d now holds %s (kind %d)\n", slot,
             kind < 0 ? "nothing" : mPlayer_ITEM_IS_UMBRELLA(kind) ? "an umbrella"
                        : mPlayer_ITEM_IS_AXE(kind) ? "an axe" : mPlayer_ITEM_IS_NET(kind) ? "a net"
                        : mPlayer_ITEM_IS_ROD(kind) ? "a fishing rod" : "a tool", kind);
}

/* The hand and head joints, so the tool and the umbrella sit in the hand.
 * Everything else the player's own per-joint callbacks do (footprints, the
 * item handover clip, effects) belongs to the one real player. */
static int Puppet_draw_After(GAME* game, cKF_SkeletonInfo_R_c* kf, int joint_no, Gfx** gfx_pp, u8* work_flag, void* arg,
                             s_xyz* rot, xyz_t* pos) {
    PLAYER_ACTOR* p = (PLAYER_ACTOR*)arg;
    (void)game; (void)kf; (void)gfx_pp; (void)work_flag; (void)rot; (void)pos;

    if (joint_no == mPlayer_JOINT_HAND) {
        Matrix_Position_Zero(&p->right_hand_pos);
        Matrix_get(&p->right_hand_mtx);
    } else if (joint_no == mPlayer_JOINT_LARM2) {
        Matrix_Position_VecX(1100.0f, &p->left_hand_pos);
        Matrix_get(&p->left_hand_mtx);
    } else if (joint_no == mPlayer_JOINT_HEAD) {
        Matrix_Position_Zero(&p->head_pos);
    }
    return TRUE;
}

/* What the local player is showing rather than holding as a tool, exactly as
 * Player_actor_draw_Normal decides it: the item lifted overhead after a
 * pick-up, what the shovel dug up as it comes out of the ground. Sent as the
 * item id, its scale and its world position, so a puppet can draw it with
 * the same field-item draw call without knowing the sender's state machine. */
static void Puppet_shown_item(PLAYER_ACTOR* lp, GAME* game, acnet_player_state_t* st) {
    mActor_name_t item = EMPTY_NO;
    f32 scale = 0.0f;
    xyz_t* pos = NULL;
    int idx = mPlib_get_player_actor_main_index(game);

    if (idx == mPlayer_INDEX_PICKUP) {
        if (lp->main_data.pickup.signboard_flag == FALSE) {
            item = lp->main_data.pickup.item;
            scale = lp->main_data.pickup.scale;
            pos = &lp->main_data.pickup.item_pos;
        }
    } else if (idx == mPlayer_INDEX_PICKUP_JUMP) {
        if (lp->main_data.pickup_jump.ftr_flag == FALSE) {
            item = lp->main_data.pickup_jump.item;
            scale = lp->main_data.pickup_jump.scale;
            pos = &lp->main_data.pickup_jump.item_pos;
        }
    } else if (idx == mPlayer_INDEX_GET_SCOOP) {
        item = lp->main_data.get_scoop.item;
        scale = lp->main_data.get_scoop.scale;
        pos = lp->keyframe0.frame_control.current_frame <= 42.0f ? &lp->scoop_pos : &lp->left_hand_pos;
    } else if (idx == mPlayer_INDEX_PUTAWAY_SCOOP) {
        item = lp->main_data.putaway_scoop.item;
        scale = lp->main_data.putaway_scoop.scale;
        pos = &lp->left_hand_pos;
    }
    if (scale > 0.0f && item != EMPTY_NO && pos != NULL) {
        st->show_item = (uint16_t)item;
        st->show_scale = scale;
        st->show_x = pos->x;
        st->show_y = pos->y;
        st->show_z = pos->z;
    }
}

static void Puppet_shown_item_draw(GAME* game, const puppet_anim_t* a) {
    xyz_t pos;

    if (!(a->show_scale > 0.0f)) {
        return;
    }
    pos = a->show_pos;
    if (mFI_GET_TYPE(mFI_GetFieldId()) == mFI_FIELD_FG) {
        if (Common_Get(clip).bg_item_clip != NULL && Common_Get(clip).bg_item_clip->single_draw_proc != NULL) {
            Common_Get(clip).bg_item_clip->single_draw_proc(game, (mActor_name_t)a->show_item, &pos, a->show_scale,
                                                            NULL, NULL, NULL);
        }
    } else if (Common_Get(clip).shop_goods_clip != NULL && Common_Get(clip).shop_goods_clip->single_draw_proc != NULL) {
        Common_Get(clip).shop_goods_clip->single_draw_proc(game, (mActor_name_t)a->show_item, &pos, a->show_scale, 0,
                                                           FALSE);
    }
}

static void Puppet_item_draw(ACTOR* actorx, GAME* game) {
    PLAYER_ACTOR* p = (PLAYER_ACTOR*)actorx;
    GRAPH* graph = game->graph;
    int kind = p->item_kind;
    int shape;
    Mtx* mtx;

    Puppet_shown_item_draw(game, &s_anim[actorx->actor_specific]);
    if (kind < 0) {
        return;
    }
    if (mPlayer_ITEM_IS_UMBRELLA(kind)) {
        TOOLS_ACTOR* umb = (TOOLS_ACTOR*)Player_actor_Get_umbrella_p(actorx, game);
        if (umb != NULL) {
            Matrix_push();
            Matrix_put(&p->right_hand_mtx);
            Matrix_get(&umb->matrix_work);
            umb->init_matrix = TRUE;
            Matrix_pull();
        }
        return;
    }
    shape = p->item_shape_type[0];
    if (!mPlayer_ITEM_DATA_VALID(shape)) {
        return;
    }
    Matrix_push();
    Matrix_put(&p->right_hand_mtx);
    mtx = _Matrix_to_Mtx_new(graph);
    if (mtx != NULL) {
        int is_gfx = mPlib_Get_Item_DataPointerType(shape) == mPlayer_ITEM_DATA_TYPE_GFX;
        _texture_z_light_fog_prim(graph);
        OPEN_POLY_OPA_DISP(graph);
        gSPMatrix(POLY_OPA_DISP++, mtx, G_MTX_NOPUSH | G_MTX_LOAD | G_MTX_MODELVIEW);
        if (is_gfx) {
            gSPDisplayList(POLY_OPA_DISP++, mPlib_Get_Item_DataPointer(shape));
        }
        CLOSE_POLY_OPA_DISP(graph);
        if (!is_gfx && p->item_keyframe.skeleton != NULL) {
            cKF_Si3_draw_R_SV(game, &p->item_keyframe, p->item_work_mtx[game->frame_counter % 2], NULL, NULL, p);
        }
    }
    Matrix_pull();
}

/* Construct the body skeleton the way the player does, but WITHOUT the global
 * side effects (no balloon child actor, no player_actor_exists flag, no camera
 * request), using the model for THAT resident's gender. */
static void Puppet_actor_ct(ACTOR* actorx, GAME* game) {
    PLAYER_ACTOR* p = (PLAYER_ACTOR*)actorx;
    int slot = actorx->actor_specific;
    int gender = Puppet_gender(slot);
    cKF_Skeleton_R_c* mdl = mPlib_get_player_mdl_p_for(gender);
    (void)game;

    OSReport("[puppet] ct: building %s body for resident %d\n", gender == mPr_SEX_FEMALE ? "girl" : "boy", slot);
    if (mdl == NULL) {
        OSReport("[puppet] ct: no player model available; puppet will not draw\n");
        return;
    }

    actorx->scale.x = 0.01f;
    actorx->scale.y = 0.01f;
    actorx->scale.z = 0.01f;

    p->now_main_index = mPlayer_INDEX_WAIT;
    p->now_item_main_index = 0;
    p->item_kind = -1;
    p->umbrella_actor = NULL;
    p->umbrella_state = aTOL_ACTION_WAIT;
    p->item_shape_type[0] = p->item_shape_type[1] = -1;
    s_anim[slot].item_kind = -1;
    s_anim[slot].item_anim = -1;

    cKF_SkeletonInfo_R_ct(&p->keyframe0, mdl, NULL, p->joint_data, p->morph_data);
    p->keyframe1 = p->keyframe0; /* as the player does (m_player_main_dma.c_inc) */

    /* Stand still until the first state arrives, and compute that pose now
     * so the very first draw is a real one rather than an all-zero skeleton. */
    s_anim[slot].built_gender = gender;
    s_anim[slot].have_seq = 0;
    Puppet_start_animation(p, slot, mPlayer_ANIM_WAIT1, mPlayer_ANIM_WAIT1, mPlayer_PART_TABLE_NORMAL, 1.0f, 1.0f,
                           1.0f, 0.0f, ACNET_ANIM_MODE_REPEAT, ACNET_ANIM_MODE_REPEAT);
    s_anim[slot].show_scale = 0.0f;
    Player_actor_set_eye_pattern(actorx, 0);
    Player_actor_set_mouth_pattern(actorx, 0);
    cKF_SkeletonInfo_R_combine_play(&p->keyframe0, &p->keyframe1, p->part_table);

    /* Solid: registered with the collision system every frame in the move proc. */
    ClObjPipe_ct(game, &p->col_pipe);
    ClObjPipe_set5(game, &p->col_pipe, actorx, &Puppet_OcInfoData);
    actorx->status_data.weight = MASSTYPE_IMMOVABLE;
    OSReport("[puppet] ct: body ready\n");

    Shape_Info_init(actorx, 0.0f, &mAc_ActorShadowCircle, 18.0f, 18.0f);
    actorx->shape_info.ofs_y = 200.0f;

    /* Draw regardless of the usual player cull volume: we always want to see
     * other residents when they are in our scene. */
    actorx->cull_width = 100000.0f;
    actorx->cull_height = 100000.0f;
    actorx->cull_distance = 100000.0f;
    actorx->cull_radius = 100000.0f;
}

static void Puppet_actor_dt(ACTOR* actorx, GAME* game) {
    PLAYER_ACTOR* p = (PLAYER_ACTOR*)actorx;

    Puppet_drop_umbrella(p);
    if (p->keyframe0.skeleton != NULL) {
        ClObjPipe_dt(game, &p->col_pipe);
    }
}

/* Per-frame: play what the other resident's game is playing. Their animation
 * indices, frames and speed arrive with every state sample; between samples
 * the animation runs on locally at their speed. */
static void Puppet_actor_move(ACTOR* actorx, GAME* game) {
    PLAYER_ACTOR* p = (PLAYER_ACTOR*)actorx;
    GAME_PLAY* play = (GAME_PLAY*)game;
    int slot = actorx->actor_specific;
    puppet_anim_t* a = &s_anim[slot];
    acnet_player_state_t st;

    if (p->keyframe0.skeleton == NULL) {
        return;
    }

    /* Take part in this frame's object collisions, like the player and the
     * villagers do, so nobody walks through us. */
    CollisionCheck_Uty_ActorWorldPosSetPipeC(actorx, &p->col_pipe);
    CollisionCheck_setOC(game, &play->collision_check, &p->col_pipe.collision_obj);

    if (pc_net_get_remote_state(slot, &st)) {
        if (st.anim0_idx != a->anim0 || st.anim1_idx != a->anim1 || st.part_table_idx != a->part_table) {
            /* New animation: start it where the sender is, blending from the
             * old pose over a few frames the way the player's own changes do. */
            Puppet_start_animation(p, slot, st.anim0_idx, st.anim1_idx, st.part_table_idx, st.anim0_frame,
                                   st.anim1_frame, st.anim_speed, -4.0f, st.anim0_mode, st.anim1_mode);
        } else if (!a->have_seq || st.seq != a->seq) {
            if (st.anim0_mode != a->mode0 || st.anim1_mode != a->mode1) {
                p->keyframe0.frame_control.mode = Puppet_mode(st.anim0_mode);
                p->keyframe1.frame_control.mode = Puppet_mode(st.anim1_mode);
                a->mode0 = st.anim0_mode;
                a->mode1 = st.anim1_mode;
            }
            p->keyframe0.frame_control.speed = st.anim_speed;
            p->keyframe1.frame_control.speed = st.anim_speed;
            Puppet_resync_frame(&p->keyframe0.frame_control, st.anim0_frame);
            Puppet_resync_frame(&p->keyframe1.frame_control, st.anim1_frame);
        }
        /* Something shown in the hands (a pick-up): the sender says where. */
        a->show_item = st.show_item;
        a->show_scale = st.show_scale > 0.0f && st.show_scale < 1.0f ? st.show_scale : 0.0f;
        a->show_pos.x = st.show_x;
        a->show_pos.y = st.show_y;
        a->show_pos.z = st.show_z;
        /* The tool in their hand, and how it is bending. */
        {
            int kind = ACNET_ITEM_TO_KIND(st.item);
            if (!mPlayer_ITEM_KIND_VALID(kind)) {
                kind = -1;
            }
            if (kind != a->item_kind) {
                Puppet_set_item(p, slot, kind, st.item_anim, st.item_frame, st.item_mode);
            } else if (st.item_anim != a->item_anim || st.item_mode != a->item_mode) {
                Puppet_set_item_anim(p, slot, st.item_anim, st.item_frame, st.item_mode);
            } else if (p->item_keyframe.animation != NULL && (!a->have_seq || st.seq != a->seq)) {
                Puppet_resync_frame(&p->item_keyframe.frame_control, st.item_frame);
            }
        }
        a->seq = st.seq;
        a->have_seq = 1;
    }

    cKF_SkeletonInfo_R_combine_play(&p->keyframe0, &p->keyframe1, p->part_table);
    if (p->item_keyframe.skeleton != NULL && p->item_keyframe.animation != NULL) {
        cKF_SkeletonInfo_R_play(&p->item_keyframe);
    }
    Puppet_face_animation(actorx);
}

/* Draw the body and what is in its hand. Deliberately NOT
 * Player_actor_draw_Normal: that path runs per-joint callbacks for
 * footprints, head turning and the item-handover clip, all of which read
 * state that belongs to the one real player. A puppet only records its hand
 * and head joints (Puppet_draw_After) and binds its own resident's textures
 * instead of the local player's bank. */
static void Puppet_actor_draw(ACTOR* actorx, GAME* game) {
    PLAYER_ACTOR* p = (PLAYER_ACTOR*)actorx;
    int slot = actorx->actor_specific;
    puppet_look_t* look = &s_look[slot];
    GRAPH* graph = game->graph;
    int buf_idx = game->frame_counter % 2;
    u8* eye;
    u8* mouth;
    u8* tex;
    u16* pal;
    u16* face_pal;
    static int logged_first_draw;

    if (p->keyframe0.skeleton == NULL) {
        return;
    }
    if (!logged_first_draw) {
        logged_first_draw = 1;
        OSReport("[puppet] first draw (resident %d)\n", slot);
    }

    if (look->valid) {
        int ei = p->eye_tex_idx;
        int mi = p->mouth_tex_idx;

        if (ei < 0 || ei >= mPlayer_EYE_TEX_NUM) {
            ei = 0;
        }
        if (mi < 0 || mi >= mPlayer_MOUTH_TEX_NUM) {
            mi = 0;
        }
        eye = look->face_tex + ei * PUPPET_TEX_STRIDE;
        mouth = look->face_tex + (mPlayer_EYE_TEX_NUM + mi) * PUPPET_TEX_STRIDE;
        tex = look->cloth_tex;
        pal = look->cloth_pal;
        face_pal = look->face_pal;
    } else {
        /* No save block for this resident yet (brand new, never saved):
         * borrow the local player's bank rather than draw nothing. */
        eye = mPlib_Get_eye_tex_p(0);
        mouth = mPlib_Get_mouth_tex_p(0);
        tex = mPlib_get_player_tex_p(game);
        pal = mPlib_get_player_pallet_p(game);
        face_pal = mPlib_get_player_face_pallet_p(game);
    }

    _texture_z_light_fog_prim(graph);
    OPEN_POLY_OPA_DISP(graph);
    gSPSegment(POLY_OPA_DISP++, ANIME_1_TXT_SEG, eye);
    gSPSegment(POLY_OPA_DISP++, ANIME_2_TXT_SEG, mouth);
    gSPSegment(POLY_OPA_DISP++, ANIME_3_TXT_SEG, tex);
    gSPSegment(POLY_OPA_DISP++, ANIME_4_TXT_SEG, pal);
    gSPSegment(POLY_OPA_DISP++, ANIME_5_TXT_SEG, face_pal);
    CLOSE_POLY_OPA_DISP(graph);

    cKF_Si3_draw_R_SV(game, &p->keyframe0, p->work_mtx[buf_idx], NULL, &Puppet_draw_After, p);
    Puppet_item_draw(actorx, game);
}

ACTOR_PROFILE Puppet_Profile = {
    mAc_PROFILE_PUPPET,
    PUPPET_ACTOR_PART,
    /* Outside the NPC part an actor's move proc only runs while it is in
     * view or carries this flag; a puppet must keep tracking its resident
     * off-screen so it is in the right place when it comes back into view. */
    ACTOR_STATE_NO_MOVE_WHILE_CULLED,
    EMPTY_NO,
    ACTOR_OBJ_BANK_KEEP,
    sizeof(PLAYER_ACTOR),
    &Puppet_actor_ct,
    &Puppet_actor_dt,
    &Puppet_actor_move,
    &Puppet_actor_draw,
    NULL,
};

/* --- Villagers -------------------------------------------------------------
 * See acnet_npc_state_t in protocol.h. Every game computes the same owner for
 * a villager from the same streamed positions; the owner streams it, the
 * others make their copy follow (aNPC_remote_control in ac_npc_move.c_inc). */
static int Puppet_blocks_adjacent(const xyz_t* a, const xyz_t* b) {
    int ax = (int)(a->x / mFI_BK_WORLDSIZE_BASE_F), az = (int)(a->z / mFI_BK_WORLDSIZE_BASE_F);
    int bx = (int)(b->x / mFI_BK_WORLDSIZE_BASE_F), bz = (int)(b->z / mFI_BK_WORLDSIZE_BASE_F);
    int dx = ax - bx, dz = az - bz;

    if (dx < 0) dx = -dx;
    if (dz < 0) dz = -dz;
    return dx <= 1 && dz <= 1; /* the 3x3 of acres a game keeps loaded around its player */
}

/* Who runs this villager: the resident talking to it, else the connected game
 * with the lowest client id among those that have its acre loaded. -1 when
 * nobody near it is connected (then everyone just runs their own copy). */
static int Puppet_npc_owner(GAME_PLAY* play, ACTOR* npc) {
    ACTOR* me = GET_PLAYER_ACTOR_ACTOR(play);
    ACTOR* talk = mDemo_Get_talk_actor();
    int self = pc_net_self_id();
    int local_slot = pc_net_local_slot();
    int best = -1;
    int slot;

    if (self < 0 || me == NULL) {
        return -1;
    }
    if (talk == npc) {
        return self;
    }
    for (slot = 0; slot < ACNET_MAX_PLAYERS; slot++) {
        acnet_player_state_t st;
        if (slot == local_slot || !pc_net_get_remote_state(slot, &st) || st.area != Puppet_area(play)) {
            continue;
        }
        if (st.talk_npc != 0 && st.talk_npc == (uint16_t)npc->npc_id) {
            return st.client_id;
        }
    }
    if (Puppet_blocks_adjacent(&me->world.position, &npc->world.position)) {
        best = self;
    }
    for (slot = 0; slot < ACNET_MAX_PLAYERS; slot++) {
        acnet_player_state_t st;
        xyz_t p;
        if (slot == local_slot || !pc_net_get_remote_state(slot, &st) || st.area != Puppet_area(play)) {
            continue;
        }
        p.x = st.x;
        p.y = st.y;
        p.z = st.z;
        if (Puppet_blocks_adjacent(&p, &npc->world.position) && (best < 0 || (int)st.client_id < best)) {
            best = st.client_id;
        }
    }
    return best;
}

int Puppet_npc_remote(ACTOR* npc, float* x, float* y, float* z, int* angle_y, int* walking, int* act, int* flags) {
    GAME_PLAY* play = (GAME_PLAY*)gamePT;
    acnet_npc_state_t st;
    int from, owner;
    int self = pc_net_self_id();

    if (self < 0 || !pc_net_puppets_enabled() || play == NULL || !Puppet_in_town(play) ||
        play->scene_id != SCENE_FG) {
        return 0;
    }
    owner = Puppet_npc_owner(play, npc);
    if (owner < 0 || owner == self) {
        return 0;
    }
    if (!pc_net_get_npc_state((unsigned)(uint16_t)npc->npc_id, &st, &from) || from != owner) {
        return 0; /* the owner has not told us yet: keep our own AI going meanwhile */
    }
    *x = st.x;
    *y = st.y;
    *z = st.z;
    *angle_y = st.angle_y;
    *walking = st.walking;
    *act = st.act;
    *flags = st.flags;
    return 1;
}

/* Stream the villagers we own, ten times a second. */
static void Puppet_npc_stream(GAME_PLAY* play) {
    acnet_npc_state_t batch[ACNET_NPC_MAX];
    int self = pc_net_self_id();
    int n = 0;
    ACTOR* a;

    static u32 tick;

    if (self < 0 || play->scene_id != SCENE_FG || (++tick % 6) != 0) {
        return;
    }
    for (a = play->actor_info.list[ACTOR_PART_NPC].actor; a != NULL && n < ACNET_NPC_MAX; a = a->next_actor) {
        NPC_ACTOR* npc = (NPC_ACTOR*)a; /* every actor in this part is an NPC_ACTOR */
        if (a->id != mAc_PROFILE_NORMAL_NPC) {
            continue;
        }
        if (Puppet_npc_owner(play, a) != self) {
            continue;
        }
        memset(&batch[n], 0, sizeof(batch[n]));
        batch[n].npc_id = (uint16_t)a->npc_id;
        batch[n].angle_y = (int16_t)a->shape_info.rotation.y;
        batch[n].x = a->world.position.x;
        batch[n].y = a->world.position.y;
        batch[n].z = a->world.position.z;
        batch[n].walking = a->speed > 0.01f ? 1 : 0;
        /* What it is doing, so the copies can do it too: hidden indoors, its
         * current act (running, singing, clapping...), its umbrella. */
        batch[n].act = (uint8_t)npc->action.idx;
        batch[n].flags = (uint8_t)((npc->condition_info.hide_flg ? ACNET_NPC_FLAG_HIDDEN : 0) |
                                   (npc->draw.sub_anim_type == aNPC_SUB_ANIM_UMBRELLA ? ACNET_NPC_FLAG_UMBRELLA : 0));
        n++;
    }
    if (n > 0) {
        pc_net_send_npc_states(batch, n);
    }
}

/* --- Land relay ------------------------------------------------------------
 * The town's field-item table (Save_t.fg) is both the persistent and the live
 * land: the loaded acres' item pointers alias it. So every change to the
 * land, whoever or whatever made it, shows up as a changed cell there. Each
 * frame: apply the cells other residents changed, then diff our table
 * against a snapshot and send what changed. Applied cells go into the
 * snapshot too, so nothing echoes back.
 *
 * NOT everything in the live table is land. While the town is loaded the
 * game swaps structure cells (houses, the dump, the shrine, mailboxes...) for
 * runtime placeholders >= DUMMY_START and restores the real ids at save time
 * (restore_fgdata in m_actor.c). Those swaps are not changes: a placeholder is
 * never sent, the snapshot keeps the last real value underneath it, and a
 * placeholder cell is never overwritten from the network (the actor that
 * owns it would put its own value back anyway). Relaying placeholders once
 * wiped the dump marker out of a stored town and crashed the next game to
 * load it. */
static u16 s_land_snapshot[ACNET_FG_CELLS];
static int s_land_snapshot_valid;

static void Puppet_land_sync(GAME_PLAY* play) {
    mActor_name_t* live = Save_GetFG();
    acnet_land_cell_t buf[ACNET_LAND_MAX_CELLS];
    int n, i, applied = 0, skipped = 0, pending = 0;

    if (!Puppet_in_town(play)) {
        return; /* incoming cells wait in pc_net's queue until we are */
    }

    if (!s_land_snapshot_valid) {
        memcpy(s_land_snapshot, live, sizeof(s_land_snapshot));
        s_land_snapshot_valid = 1;
        OSReport("[land] watching the town's %d field cells for changes\n", ACNET_FG_CELLS);
        return;
    }

    /* 1. Apply what the others changed. */
    while ((n = pc_net_take_land_cells(buf, ACNET_LAND_MAX_CELLS)) > 0) {
        for (i = 0; i < n; i++) {
            const acnet_land_cell_t* c = &buf[i];
            int idx;
            if (c->fx >= ACNET_FG_BLOCK_X || c->fz >= ACNET_FG_BLOCK_Z || c->utx >= ACNET_FG_UT ||
                c->utz >= ACNET_FG_UT || ACNET_LAND_ITEM_IS_RUNTIME(c->item)) {
                skipped++;
                continue;
            }
            idx = ACNET_FG_CELL_INDEX(c->fx, c->fz, c->utx, c->utz);
            if (ACNET_LAND_ITEM_IS_RUNTIME(live[idx])) {
                skipped++; /* a structure stands here in our game; leave it to its actor */
                continue;
            }
            live[idx] = (mActor_name_t)c->item;
            s_land_snapshot[idx] = (u16)c->item;
            applied++;
        }
    }
    if (applied) {
        /* The field-item manager rebuilds the visible acres' item actors when
         * this flag is set, the same way the game does after a local change. */
        if (mFI_CheckFieldData()) {
            mFI_SetFGUpData();
        }
        OSReport("[land] applied %d cell change(s) from other residents%s\n", applied,
                 skipped ? " (some placeholders ignored)" : "");
    } else if (skipped) {
        OSReport("[land] ignored %d placeholder cell(s) from other residents\n", skipped);
    }

    /* 2. Send what changed here. */
    for (i = 0; i < ACNET_FG_CELLS; i++) {
        if (ACNET_LAND_ITEM_IS_RUNTIME(live[i])) {
            continue; /* a structure's placeholder, not a change */
        }
        if (live[i] != (mActor_name_t)s_land_snapshot[i]) {
            acnet_land_cell_t* c = &buf[pending];
            int cell = i % ACNET_FG_UT;
            int row  = (i / ACNET_FG_UT) % ACNET_FG_UT;
            int blk  = i / (ACNET_FG_UT * ACNET_FG_UT);
            c->fx = (u8)(blk % ACNET_FG_BLOCK_X);
            c->fz = (u8)(blk / ACNET_FG_BLOCK_X);
            c->utx = (u8)cell;
            c->utz = (u8)row;
            c->item = (u16)live[i];
            c->reserved = 0;
            s_land_snapshot[i] = (u16)live[i];
            if (++pending == ACNET_LAND_MAX_CELLS) {
                pc_net_send_land_cells(buf, pending);
                pending = 0;
            }
        }
    }
    if (pending) {
        pc_net_send_land_cells(buf, pending);
    }
}

/* Find the puppet actor for a given resident slot, or NULL. */
static ACTOR* Puppet_find(GAME_PLAY* play, int slot) {
    ACTOR* a = play->actor_info.list[PUPPET_ACTOR_PART].actor;
    while (a != NULL) {
        if (a->id == PUPPET_PROFILE_ID && a->actor_specific == slot) {
            return a;
        }
        a = a->next_actor;
    }
    return NULL;
}

/* Everything we TELL the others: which save block we are, where we are and
 * what our body is doing, our own character and house when they changed,
 * the villagers we own, the weather if we are the authority. Split out from
 * the per-frame update because the player's move proc, which drives that,
 * does not run while the game is paused (pockets open, a menu, a letter):
 * without this the others saw us vanish three seconds into reading a letter.
 * paused: the pose is frozen, so it is sent with speed 0 to hold it. */
static int s_updated_this_frame;

static void Puppet_stream_local(GAME_PLAY* play, ACTOR* player_actor, int paused) {
    PLAYER_ACTOR* lp = (PLAYER_ACTOR*)player_actor;
    GAME* game = (GAME*)play;
    int local_slot = pc_net_local_slot();
    static u32 push_tick;

    if (local_slot < 0 || !Puppet_in_town(play)) {
        return;
    }

    /* Our slot must be the save block our character lives in (see
     * acnet_claim_slot_t). The block is only known once we are in town. */
    pc_net_set_player_no(Common_Get(player_no));

    /* Where we are, and exactly what our body is doing, so our puppet in the
     * others' games plays the same thing. */
    {
        acnet_player_state_t st;
        memset(&st, 0, sizeof(st));
        st.area = Puppet_area(play);
        st.x = player_actor->world.position.x;
        st.y = player_actor->world.position.y;
        st.z = player_actor->world.position.z;
        st.angle_y = (int16_t)player_actor->shape_info.rotation.y;
        st.anim0_idx = (int16_t)lp->animation0_idx;
        st.anim1_idx = (int16_t)lp->animation1_idx;
        st.part_table_idx = (int8_t)lp->part_table_idx;
        st.anim0_frame = lp->keyframe0.frame_control.current_frame;
        st.anim1_frame = lp->keyframe1.frame_control.current_frame;
        st.anim_speed = paused ? 0.0f : lp->keyframe0.frame_control.speed;
        st.item = mPlayer_ITEM_KIND_VALID(lp->item_kind) ? ACNET_ITEM_FROM_KIND(lp->item_kind) : ACNET_ITEM_NONE;
        st.item_anim = (int16_t)lp->item_animation_idx[lp->item_bank_idx & 1];
        st.item_frame = lp->item_keyframe.frame_control.current_frame;
        st.anim0_mode = (uint8_t)lp->keyframe0.frame_control.mode;
        st.anim1_mode = (uint8_t)lp->keyframe1.frame_control.mode;
        st.item_mode = (uint8_t)lp->item_keyframe.frame_control.mode;
        Puppet_shown_item(lp, game, &st);
        st.flags = Common_Get(player_bee_swell_flag) ? ACNET_STATE_FLAG_BEE_SWELL : 0;
        {
            ACTOR* talk = mDemo_Get_talk_actor();
            st.talk_npc = (talk != NULL && talk->part == ACTOR_PART_NPC) ? (uint16_t)talk->npc_id : 0;
        }
        pc_net_send_player_state(&st);
    }

    /* Our own character and house go out to the others as soon as they
     * change (a brand-new resident who has never saved, a new shirt, moved
     * furniture), without waiting for a save. pc_net hashes the blocks and
     * only sends real changes; checked once a second. */
    if (local_slot < ACNET_MAX_PLAYERS && (++push_tick % 60) == 30 && Puppet_slot_has_resident(local_slot)) {
        static Private_c push_private ATTRIBUTE_ALIGN(32);
        static mHm_hs_c push_home ATTRIBUTE_ALIGN(32);
        memcpy(&push_private, Save_GetPointer(private_data[local_slot]), sizeof(push_private));
        memcpy(&push_home, Save_GetPointer(homes[local_slot]), sizeof(push_home));
        pc_save_bswap_private(&push_private, PC_BSWAP_TO_BE);
        pc_save_bswap_home(&push_home, PC_BSWAP_TO_BE);
        if (pc_net_push_own_blocks(&push_private, sizeof(push_private), &push_home, sizeof(push_home), 0)) {
            OSReport("[puppet] sent my character and house to the other residents (they changed)\n");
        }
    }

    /* The authority's sky is the town's sky, and its land-renewal timestamp
     * is everyone's, so nobody renews twice. */
    if (pc_net_is_authority()) {
        pc_net_send_weather(Common_Get(weather), Common_Get(weather_intensity), Save_GetPointer(all_grow_renew_time),
                            sizeof(lbRTC_time_c));
    }

    /* Villagers: stream the ones we own (frozen with us while paused). */
    if (pc_net_puppets_enabled()) {
        Puppet_npc_stream(play);
    }
}

/* Called at the end of every play frame (play_main). If the player's move
 * proc did not run this frame -- the game is paused -- send our state anyway. */
void Puppet_net_idle(GAME* game) {
    GAME_PLAY* play = (GAME_PLAY*)game;

    if (!s_updated_this_frame && pc_net_local_slot() >= 0) {
        ACTOR* pl = GET_PLAYER_ACTOR_ACTOR(play);
        if (pl != NULL) {
            Puppet_stream_local(play, pl, TRUE);
        }
    }
    s_updated_this_frame = 0;
}

void Puppet_net_update_local(ACTOR* player_actor, GAME* game) {
    GAME_PLAY* play = (GAME_PLAY*)game;
    PLAYER_ACTOR* lp = (PLAYER_ACTOR*)player_actor;
    int local_slot = pc_net_local_slot();
    int slot;

    if (local_slot < 0) {
        return; /* single-player: no server connected */
    }
    s_updated_this_frame = 1;

    /* 0b. Do not walk through other residents. The collision system already
     *     works out how far we overlap a puppet (its body is immovable, so
     *     the whole push lands on us), but the player's walking code never
     *     consumes that push: in the original game villagers get shoved and
     *     the player never does. So when the thing we bumped last frame was
     *     a puppet, take the push here, before this frame's step. */
    if (Puppet_in_town(play) && ClObj_DID_COLLIDE(lp->col_pipe.collision_obj)) {
        ACTOR* hit = lp->col_pipe.collision_obj.collided_actor;
        if (hit != NULL && hit->id == PUPPET_PROFILE_ID) {
            player_actor->world.position.x += player_actor->status_data.collision_vec.x;
            player_actor->world.position.z += player_actor->status_data.collision_vec.z;
            player_actor->status_data.collision_vec.x = 0.0f;
            player_actor->status_data.collision_vec.z = 0.0f;
        }
    }

    /* 1. Tell the others: our slot, our state, our blocks, our villagers. */
    Puppet_stream_local(play, player_actor, FALSE);

    /* 1b. Take any other resident's freshly saved character and house into
     *     our running town. Those blocks are theirs alone, so overwriting
     *     them in place is safe: every pointer into the save stays valid,
     *     only the contents change, and it happens here between the game's
     *     own reads rather than from the network pump. Their puppet's look
     *     is rebuilt from the new block on its next update. */
    for (slot = 0; slot < 4; slot++) {
        if (slot == local_slot) {
            continue;
        }
        if (pc_net_take_resident_update(slot, Save_GetPointer(private_data[slot]), sizeof(Private_c),
                                        Save_GetPointer(homes[slot]), sizeof(mHm_hs_c))) {
            pc_save_bswap_private(Save_GetPointer(private_data[slot]), PC_BSWAP_FROM_BE);
            pc_save_bswap_home(Save_GetPointer(homes[slot]), PC_BSWAP_FROM_BE);
            s_look[slot].valid = 0;
            OSReport("[puppet] resident %d's new character and house are now in this town\n", slot);
        }
    }

    /* 1c. Land: apply the others' changes, send ours. */
    Puppet_land_sync(play);

    /* 1d. The world's clockwork: take the authority's sky and its
     *     land-renewal timestamp (the authority sends them in Puppet_stream_local). */
    if (Puppet_in_town(play)) {
        if (!pc_net_is_authority()) {
            int type, intensity;
            lbRTC_time_c renew;
            if (pc_net_take_weather(&type, &intensity, &renew, sizeof(renew))) {
                if (memcmp(&renew, Save_GetPointer(all_grow_renew_time), sizeof(renew)) != 0) {
                    Save_Set(all_grow_renew_time, renew);
                }
                if (type >= 0 && type < 16 && intensity >= 0 && intensity < 16 &&
                    (type != Common_Get(weather) || intensity != Common_Get(weather_intensity)) &&
                    play->scene_id == SCENE_FG && CLIP(weather_clip) != NULL && CLIP(weather_clip)->actor != NULL &&
                    CLIP(weather_clip)->actor->ct_proc == NULL &&
                    CLIP(weather_clip)->change_weather_instance != NULL) {
                    OSReport("[world] weather from the host: type %d intensity %d (was %d/%d)\n", type, intensity,
                             (int)Common_Get(weather), (int)Common_Get(weather_intensity));
                    CLIP(weather_clip)->change_weather_instance(CLIP(weather_clip)->actor, (s16)type,
                                                                 (s16)intensity);
                    Save_Set(weather, (u8)((intensity & 0xF) | ((type & 0xF) << 4)));
                }
            }
        }
    }

    if (!pc_net_puppets_enabled() || !Puppet_in_town(play)) {
        return; /* other residents not drawn (or not in town yet); town sync is unaffected */
    }

    /* 2. Update existing puppets from network state, deleting those whose
     *    resident has gone (or whose body no longer matches their block).
     *    Capture next_actor before any delete. */
    {
        ACTOR* a = play->actor_info.list[PUPPET_ACTOR_PART].actor;
        while (a != NULL) {
            ACTOR* next = a->next_actor;
            if (a->id == PUPPET_PROFILE_ID) {
                acnet_player_state_t st;
                int s = a->actor_specific;
                if (!pc_net_get_remote_state(s, &st)) {
                    OSReport("[puppet] resident %d left; removing puppet\n", s);
                    Actor_info_delete(&play->actor_info, a, game);
                } else if (st.area != Puppet_area(play)) {
                    OSReport("[puppet] resident %d went somewhere else (area %u, we are in %u); removing puppet\n",
                             s, (unsigned)st.area, (unsigned)Puppet_area(play));
                    Actor_info_delete(&play->actor_info, a, game);
                } else if (Puppet_slot_has_resident(s) && Puppet_gender(s) != s_anim[s].built_gender) {
                    OSReport("[puppet] resident %d's character changed body; rebuilding puppet\n", s);
                    Actor_info_delete(&play->actor_info, a, game);
                } else {
                    a->world.position.x = st.x;
                    a->world.position.y = st.y;
                    a->world.position.z = st.z;
                    a->shape_info.rotation.y = (s16)st.angle_y;
                    Puppet_look_refresh(s, (st.flags & ACNET_STATE_FLAG_BEE_SWELL) != 0);
                }
            }
            a = next;
        }
    }

    /* 3. Spawn a puppet for any present resident that does not have one. */
    for (slot = 0; slot < 4; slot++) {
        acnet_player_state_t st;
        if (slot == local_slot) {
            continue;
        }
        if (!pc_net_get_remote_state(slot, &st)) {
            continue;
        }
        if (st.area != Puppet_area(play)) {
            continue; /* indoors while we are out, or the other way round */
        }
        if (Puppet_find(play, slot) != NULL) {
            continue;
        }
        Puppet_look_refresh(slot, (st.flags & ACNET_STATE_FLAG_BEE_SWELL) != 0);
        {
            ACTOR* made = Actor_info_make_actor(&play->actor_info, game, mAc_PROFILE_PUPPET, st.x, st.y, st.z, 0,
                                                (s16)st.angle_y, 0, -1, -1, -1, EMPTY_NO, (s16)slot, -1, -1);
            OSReport("[puppet] resident %d appeared at %.0f,%.0f,%.0f: %s\n", slot, st.x, st.y, st.z,
                     made ? "puppet created" : "FAILED to create puppet actor");
        }
    }
}

#else /* !TARGET_PC : puppets are a PC-build-only feature */

void Puppet_net_update_local(ACTOR* player_actor, GAME* game) {
    (void)player_actor;
    (void)game;
}

void Puppet_net_idle(GAME* game) {
    (void)game;
}


#endif /* TARGET_PC */
